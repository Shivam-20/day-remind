# Local dev: copy to .env (cp .env.example .env).
# Production (Docker, Pterodactyl, systemd): set variables in the host/panel
# environment — they take precedence over any .env file. Optional:
#   DAY_REMIND_SKIP_DOTENV=1  — never read .env from disk
#   DOTENV_PATH=/path/to/.env — extra file (still does not override host env)

# Local (docker compose) — matches the credentials in docker-compose.yml
DATABASE_URL=mongodb://dayremind:dayremind@localhost:27017/day_remind?authSource=admin

# MongoDB Atlas — replace the placeholders with your own cluster's values
# DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/day_remind?retryWrites=true&w=majority

WEB_PORT=8090
# Must be at least 32 characters. Generate one with: openssl rand -hex 32
SESSION_KEY=change-me-to-at-least-32-random-characters
TZ=Asia/Kolkata

# Admin panel bootstrap. Comma-separated; matching is case-insensitive.
# A user with one of these addresses is promoted to admin on their next
# signup or login, and cannot be demoted from the UI while listed here.
# Leave empty for no admins.
ADMIN_EMAILS=

# ---------------------------------------------------------------- delivery
#
# The variables below SEED a fresh install only. Once the settings document
# exists, the database is authoritative and delivery is configured in the admin
# panel (Admin -> Delivery) — editing these has no further effect.

# How often the scheduler sweeps for due reminders.
SCHEDULER_INTERVAL=30s

# Email (SMTP). Seeds the instance mail server when both are set.
# SMTP_TLS: starttls (default, port 587) | implicit (SMTPS, port 465) | none
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=reminders@example.com
SMTP_TLS=starttls

# Local development against the MailHog container in docker-compose.yml.
# Nothing leaves the machine; read the mail at http://localhost:8025
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_TLS=none
# SMTP_FROM=dev@day-remind.local

# Telegram. Create a bot with @BotFather and paste its token here.
# The bot long-polls, so no public URL or webhook is required.
TELEGRAM_BOT_TOKEN=
# Override only for testing against a stub API.
# TELEGRAM_API_BASE=https://api.telegram.org

# Users may point their own mail server at a loopback or private address.
# Off by default: it otherwise lets any user make this process connect to an
# internal service. Turn it on for local development against MailHog.
ALLOW_PRIVATE_SMTP=false

# NOTE: SESSION_KEY also derives the key that encrypts stored SMTP passwords
# and bot tokens. Changing it makes every stored credential unreadable; they
# have to be re-entered in the admin panel and in each user's settings.
