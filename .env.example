DATABASE_URL=mongodb://dayremind:dayremind@localhost:27017/day_remind?authSource=admin
WEB_PORT=8090
# Public path behind home Caddy / OCI tunnel (see AGENTS.md "Production deploy")
# APP_BASE_PATH=/remind
SESSION_KEY=change-me-to-at-least-32-random-characters
ADMIN_EMAILS=admin@example.com
TZ=Asia/Kolkata

# Delivery (email + Telegram)
# Email provider: resend (API) or smtp (your own mail server). Can also be
# chosen per-deployment in Admin → Delivery settings; env values are fallback.
RESEND_API_KEY=
EMAIL_FROM=reminders@example.com
# SMTP transport (alternative to Resend) — used for alerts, password resets,
# and new-account verification emails when selected as the provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (default, 587) | ssl (implicit TLS, 465) | none
SMTP_TLS=starttls
TELEGRAM_BOT_TOKEN=
# How the bot receives updates: polling (default, no public URL needed) | webhook | off
# When TELEGRAM_GATEWAY_URL is set, the gateway manages the Telegram connection and
# this setting is ignored for transport. Outbound sends and inbound polling go through
# the gateway instead of api.telegram.org directly.
# webhook mode requires an https WEBHOOK_BASE_URL (Telegram rejects plain http)
TELEGRAM_UPDATE_MODE=polling
# Optional secret_token for webhook mode; incoming updates are rejected on mismatch
TELEGRAM_WEBHOOK_SECRET=

# --- Telegram Gateway integration (optional) ---
# When set, day-remind routes all Telegram traffic through the gateway:
#   Outbound: sendMessage/edit/answerCallback via gateway /v1/telegram/{method}
#   Inbound: poll gateway /v1/inbound/updates (default) or accept webhook pushes
# The gateway holds the bot token; day-remind authenticates with TELEGRAM_GATEWAY_API_TOKEN.
# Configure the same bot token + webhook secret on the gateway side.
TELEGRAM_GATEWAY_URL=
TELEGRAM_GATEWAY_API_TOKEN=
# How day-remind receives updates from the gateway: poll | webhook | both (default: poll)
TELEGRAM_GATEWAY_INBOUND_MODE=poll

# Google OAuth (Calendar + Gmail sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8090/api/integrations/google/callback

# Web push (generate VAPID keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# SMS via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional LLM for mail wording generation (degrades gracefully without a key).
# AI_PROVIDER=openrouter   # openrouter | gemini (default: openrouter if OPENROUTER_API_KEY set, else gemini)
AI_PROVIDER=
OPENROUTER_API_KEY=
# OpenRouter model slug (default google/gemini-2.5-flash)
OPENROUTER_MODEL=
# Direct Google Gemini API (when AI_PROVIDER=gemini or no OpenRouter key)
GEMINI_API_KEY=
GEMINI_MODEL=

# Public URL for outbound webhooks
WEBHOOK_BASE_URL=http://localhost:8090

# Free tier reminder limit (default 50)
MAX_FREE_REMINDERS=50
